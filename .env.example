NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/prila

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ADMIN_TTL=8h

# JSON map: {"ops@prila.local":"strong-password"}
ADMIN_LOGINS={"ops@prila.local":"change-me-admin"}

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dev/test only — returns OTP in API response when true
ALLOW_OTP_DEBUG=true

# SMS (optional until DLT provider is ready)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_OTP=

# Cloudflare R2 (optional in local; required for uploads in prod)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Firebase Admin (shared project) — absolute/relative path to service account JSON.
# Leave empty for local/dev: sendPush returns { ok:false, reason:'fcm_disabled' }.
# When ready: set path + place google-services.json / GoogleService-Info.plist in Flutter apps.
FIREBASE_SERVICE_ACCOUNT_PATH=prila-backend/prila-9c4ed-firebase-adminsdk-fbsvc-69eb21f5da.json
