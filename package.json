{
  "name": "prila-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Prila API — Fastify + MongoDB + Socket.io",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "h3-js": "^4.5.0",
    "mongoose": "^9.12.1",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
